# SignalBrief Environment Configuration
# Copy this file to .env and populate with your local values.
# NEVER commit .env to version control.

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Default Monitoring Domain
DEFAULT_DOMAIN=manufacturing

# Cloudflare Configuration (Phase 3 & 5)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
D1_DATABASE_ID=your_d1_database_id_here
R2_BUCKET_NAME=signalbrief-reports
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_key_here

# Email Delivery Configuration (Gmail SMTP - Phase 4)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password_here
EMAIL_FROM_NAME="SignalBrief Intelligence"
TEST_RECIPIENT_EMAIL=your_test_recipient@example.com

# Pipeline Local Data Paths (Defaults resolve relative to repo root)
DATA_DIR=data
REPORTS_DIR=reports
CONFIG_DIR=configs
