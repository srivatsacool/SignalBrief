# Local Data Directories (Keep folder structure via .gitkeep, do not commit local scraped/private datasets)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/evaluation/*
!data/evaluation/.gitkeep
# data/samples/ can contain small anonymized/synthetic test fixtures

# Generated Reports (Keep folder structure, do not commit generated user reports)
reports/generated/*
!reports/generated/.gitkeep
reports/previews/*
!reports/previews/.gitkeep

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

