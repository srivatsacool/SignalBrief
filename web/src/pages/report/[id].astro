---
import Layout from '../../layouts/Layout.astro';
import DevelopmentCard from '../../components/DevelopmentCard.jsx';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const generatedDir = path.resolve('../reports/generated');
  if (fs.existsSync(generatedDir)) {
    const files = fs.readdirSync(generatedDir).filter(f => f.endsWith('.json'));
    if (files.length > 0) {
      return files.map(file => {
        const id = file.replace('.json', '');
        return { params: { id } };
      });
    }
  }
  return [
    { params: { id: "daily_brief_manufacturing_2026-09-28" } }
  ];
}

const { id } = Astro.params;

let reportData: any = null;
try {
  const filePath = path.resolve(`../reports/generated/${id}.json`);
  if (fs.existsSync(filePath)) {
    const content = fs.readFileSync(filePath, 'utf-8');
    reportData = JSON.parse(content);
  }
} catch (e) {
  console.warn("Could not load report by id:", e);
}

if (!reportData) {
  reportData = {
    id,
    domain_name: "Manufacturing",
    report_date: "2026-09-28",
    executive_summary: "Automated analysis of industrial AI deployment, robotics expansion, and federal standards across verified public sources.",
    developments: [],
    what_to_watch_next: []
  };
}
---

<Layout title={`SignalBrief | ${reportData.domain_name} Briefing (${reportData.report_date})`} domain={reportData.domain_name}>
  <div class="space-y-8">
    <div class="flex items-center justify-between border-b border-slate-800 pb-4">
      <div>
        <a href="/" class="text-xs text-sky-400 hover:text-sky-300 font-medium transition-colors">
          ← Back to Today's Dashboard
        </a>
        <h1 class="text-2xl font-extrabold text-white mt-2">
          {reportData.domain_name} Daily Intelligence Brief
        </h1>
        <p class="text-xs text-slate-400 mt-0.5">
          Generated on {reportData.report_date} · ID: {id}
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href={`/reports/generated/${id}.html`}
          target="_blank"
          class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold transition-colors border border-slate-700"
        >
          View Raw HTML ↗
        </a>
      </div>
    </div>

    <!-- Executive Summary -->
    <section class="bg-slate-900/80 border border-slate-800 rounded-xl p-6">
      <h2 class="text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">Executive Summary</h2>
      <p class="text-sm text-slate-200 leading-relaxed">
        {reportData.executive_summary}
      </p>
    </section>

    <!-- Developments -->
    <section class="space-y-4">
      <h2 class="text-lg font-bold text-white">Reported Developments</h2>
      <div class="space-y-4">
        {reportData.developments && reportData.developments.length > 0 ? (
          reportData.developments.map((dev: any) => (
            <DevelopmentCard client:load development={dev} />
          ))
        ) : (
          <p class="text-sm text-slate-500 py-4">No development details recorded for this report.</p>
        )}
      </div>
    </section>

    <!-- Horizon -->
    {reportData.what_to_watch_next && reportData.what_to_watch_next.length > 0 && (
      <section class="bg-slate-900/60 border border-slate-800 rounded-xl p-6">
        <h2 class="text-base font-bold text-amber-300 uppercase tracking-wide mb-3">
          What To Watch Next
        </h2>
        <ul class="space-y-2 text-sm text-slate-300">
          {reportData.what_to_watch_next.map((item: string) => (
            <li class="flex items-start gap-2">
              <span class="text-amber-400 font-bold">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
