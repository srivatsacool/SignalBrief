---
import Layout from '../../layouts/Layout.astro';
import DevelopmentCard from '../../components/DevelopmentCard.jsx';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const generatedDir = path.resolve('../reports/generated');
  if (fs.existsSync(generatedDir)) {
    const files = fs.readdirSync(generatedDir).filter(f => f.endsWith('.json'));
    if (files.length > 0) {
      return files.map(file => {
        const id = file.replace('.json', '');
        return { params: { id } };
      });
    }
  }
  return [
    { params: { id: "daily_brief_manufacturing_2026-09-28" } }
  ];
}

const { id } = Astro.params;

let reportData: any = null;
try {
  const filePath = path.resolve(`../reports/generated/${id}.json`);
  if (fs.existsSync(filePath)) {
    const content = fs.readFileSync(filePath, 'utf-8');
    reportData = JSON.parse(content);
  }
} catch (e) {
  console.warn("Could not load report by id:", e);
}

if (!reportData) {
  reportData = {
    id,
    domain_name: "World & Manufacturing",
    report_date: "2026-09-28",
    executive_summary: "Automated analysis of industrial AI deployment, robotics expansion, and federal standards across verified public sources.",
    developments: [],
    what_to_watch_next: []
  };
}
---

<Layout title={`SignalBrief | ${reportData.domain_name} (${reportData.report_date})`} domain={reportData.domain_name}>
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#252832] pb-4">
      <div>
        <a href="/" class="text-xs text-[#18D69A] hover:underline font-mono transition-colors">
          ← Back to Today's Dashboard
        </a>
        <h1 class="text-2xl font-extrabold text-[#F4F5F7] mt-1.5 tracking-tight sm:text-3xl">
          {reportData.domain_name} Intelligence Briefing
        </h1>
        <p class="text-xs text-[#9299A8] font-mono mt-0.5">
          Generated on {reportData.report_date} · ID: {id}
        </p>
      </div>
      <div class="flex items-center gap-2">
        <a
          href={`/api/reports/${id}/html`}
          target="_blank"
          class="px-3.5 py-1.5 rounded-lg bg-[#121318] hover:bg-[#171920] text-[#18D69A] text-xs font-mono font-semibold transition-colors border border-[#252832]"
        >
          View Raw Source HTML ↗
        </a>
      </div>
    </div>

    <!-- Executive Summary -->
    <section class="bg-[#0D0E12] border border-[#252832] rounded-xl p-6 space-y-2 shadow-sm">
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[#18D69A] flex items-center gap-2">
        <span>■</span> Executive Summary
      </h2>
      <p class="text-sm text-[#F4F5F7] leading-relaxed font-sans">
        {reportData.executive_summary}
      </p>
    </section>

    <!-- Developments with Immediate Inline Citations -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#252832] pb-2">
        <h2 class="text-base font-bold text-[#F4F5F7] tracking-tight">
          Synthesized Developments
        </h2>
        <span class="text-xs font-mono text-[#9299A8]">
          100% Verified Citations
        </span>
      </div>

      <div class="space-y-4">
        {reportData.developments && reportData.developments.length > 0 ? (
          reportData.developments.map((dev: any) => (
            <DevelopmentCard client:load development={dev} />
          ))
        ) : (
          <p class="text-xs font-mono text-[#626B7B] py-4 text-center">No development details recorded for this report.</p>
        )}
      </div>
    </section>

    <!-- Horizon Scan -->
    {reportData.what_to_watch_next && reportData.what_to_watch_next.length > 0 && (
      <section class="bg-[#0D0E12] border border-[#252832] rounded-xl p-6 space-y-3 shadow-sm">
        <h3 class="text-xs font-mono font-bold text-[#E5A93C] uppercase tracking-wide">
          What To Watch Next (Next 30 Days)
        </h3>
        <ul class="space-y-2 text-xs font-sans text-[#9299A8]">
          {reportData.what_to_watch_next.map((item: string) => (
            <li class="flex items-start gap-2">
              <span class="text-[#E5A93C] font-bold">•</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
