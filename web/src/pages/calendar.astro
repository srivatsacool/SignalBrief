---
import Layout from '../layouts/Layout.astro';
import CalendarView from '../components/CalendarView.jsx';
import fs from 'node:fs';
import path from 'node:path';

let reportsList: any[] = [];
try {
  const generatedDir = path.resolve('../reports/generated');
  if (fs.existsSync(generatedDir)) {
    const files = fs.readdirSync(generatedDir).filter(f => f.endsWith('.json')).sort().reverse();
    reportsList = files.map(file => {
      const content = fs.readFileSync(path.join(generatedDir, file), 'utf-8');
      return JSON.parse(content);
    });
  }
} catch (e) {
  console.warn("Could not read historical reports:", e);
}
---

<Layout title="SignalBrief | Report Calendar" domain="Calendar">
  <div class="space-y-6">
    
    {/* Page Header matching Panel 7/9 */}
    <div class="flex items-start justify-between pb-2 border-b border-[#21232B]">
      <div class="space-y-1">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-[#E5A93C]/10 border border-[#E5A93C]/20 flex items-center justify-center text-[#E5A93C]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="2" />
              <line x1="16" y1="2" x2="16" y2="6" stroke-width="2" />
              <line x1="8" y1="2" x2="8" y2="6" stroke-width="2" />
              <line x1="3" y1="10" x2="21" y2="10" stroke-width="2" />
            </svg>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-white tracking-tight">Report Calendar</h1>
            <p class="text-xs text-[#9299A8] mt-0.5">
              View past reports and access the archive.
            </p>
          </div>
        </div>
      </div>
      <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#121318] border border-[#21232B] font-mono text-xs text-[#9299A8]">
        <span class="w-2 h-2 rounded-full bg-[#18D69A]"></span>
        <span>Archive Synchronized</span>
      </div>
    </div>

    {/* Calendar View Component matching Panel 7/9 */}
    <CalendarView client:load reports={reportsList} />
  </div>
</Layout>
