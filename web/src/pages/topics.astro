---
import Layout from '../layouts/Layout.astro';

const topics = [
  {
    name: "Industrial AI",
    description: "Machine learning, computer vision defect inspection, generative process optimization, and factory floor digital twins.",
    keywords: ["computer vision", "defect detection", "generative ai", "machine learning"],
    color: "sky"
  },
  {
    name: "Production Technology",
    description: "Robotics automation, automated guided vehicles (AGVs), CNC machining, additive manufacturing, and gigafactory lines.",
    keywords: ["robotics", "automation", "3d printing", "smart factory"],
    color: "indigo"
  },
  {
    name: "Supply Chain Resilience",
    description: "Maritime shipping, freight rates, port congestion, warehouse logistics, nearshoring, and component procurement.",
    keywords: ["logistics", "freight", "warehousing", "procurement"],
    color: "emerald"
  },
  {
    name: "Standards & Governance",
    description: "NIST cybersecurity frameworks, federal technology grant allocations, MEP centers, and industrial safety compliance.",
    keywords: ["nist", "compliance", "grants", "cybersecurity"],
    color: "amber"
  },
  {
    name: "Predictive Maintenance",
    description: "IoT vibration sensors, condition-based monitoring, acoustic analysis, and predictive motor failure prevention.",
    keywords: ["vibration analysis", "sensor monitoring", "downtime prevention"],
    color: "rose"
  },
  {
    name: "Workforce Analytics",
    description: "Technical apprenticeships, industrial STEM hiring, factory wage trends, and automation retraining programs.",
    keywords: ["apprenticeship", "talent pipeline", "workforce development"],
    color: "purple"
  }
];

const approvedSources = [
  { name: "NIST Manufacturing News", type: "Federal Agency / Standards", url: "https://www.nist.gov" },
  { name: "Manufacturing Dive", type: "Trade Journalism", url: "https://www.manufacturingdive.com" },
  { name: "Supply Chain Dive", type: "Logistics Intelligence", url: "https://www.supplychaindive.com" },
  { name: "The Robot Report", type: "Automation & Robotics", url: "https://www.roboticsbusinessreview.com" },
  { name: "MIT Technology Review", type: "Academic & Frontier Tech", url: "https://www.technologyreview.com" }
];
---

<Layout title="SignalBrief | Topics & Sources Explorer" domain="Manufacturing">
  <div class="space-y-8">
    <div>
      <h1 class="text-2xl font-extrabold text-white">Topics & Taxonomy</h1>
      <p class="text-sm text-slate-400 mt-1">
        Core analytical subtopics and monitored thematic taxonomies for the Manufacturing domain.
      </p>
    </div>

    <!-- Subtopics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {topics.map((t) => (
        <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-6 flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <h3 class="text-lg font-bold text-white mb-2">{t.name}</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">{t.description}</p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-800/80">
            {t.keywords.map((kw) => (
              <span class="text-[11px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700/60">
                {kw}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Verified Sources Section -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-white">Verified Public Sources</h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Empirically audited feeds monitored for SignalBrief intelligence gathering.
          </p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded bg-sky-950 text-sky-400 border border-sky-800/60 font-semibold">
          5 Verified Sources
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {approvedSources.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-lg bg-slate-950/60 border border-slate-800 hover:border-sky-700/60 transition-colors flex items-center justify-between"
          >
            <div>
              <span class="font-semibold text-sm text-slate-200 block">{s.name}</span>
              <span class="text-xs text-slate-500">{s.type}</span>
            </div>
            <span class="text-sky-400 text-xs">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
