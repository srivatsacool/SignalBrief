---
import Layout from '../layouts/Layout.astro';

const topics = [
  {
    name: "Industrial AI & Vision",
    description: "Machine learning, computer vision defect inspection, generative process optimization, and factory floor digital twins.",
    keywords: ["computer vision", "defect detection", "generative ai", "machine learning"],
    color: "#32B8F4"
  },
  {
    name: "Production Technology & Robotics",
    description: "Robotics automation, automated guided vehicles (AGVs), CNC machining, additive manufacturing, and gigafactory lines.",
    keywords: ["robotics", "automation", "3d printing", "smart factory"],
    color: "#18D69A"
  },
  {
    name: "Supply Chain Resilience",
    description: "Maritime shipping, freight rates, port congestion, warehouse logistics, nearshoring, and component procurement.",
    keywords: ["logistics", "freight", "warehousing", "procurement"],
    color: "#32B8F4"
  },
  {
    name: "Standards & Governance",
    description: "NIST cybersecurity frameworks, federal technology grant allocations, MEP centers, and industrial safety compliance.",
    keywords: ["nist", "compliance", "grants", "cybersecurity"],
    color: "#E5A93C"
  },
  {
    name: "Predictive Maintenance",
    description: "IoT vibration sensors, condition-based monitoring, acoustic analysis, and predictive motor failure prevention.",
    keywords: ["vibration analysis", "sensor monitoring", "downtime prevention"],
    color: "#32B8F4"
  },
  {
    name: "Workforce & Labor Analytics",
    description: "Technical apprenticeships, industrial STEM hiring, factory wage trends, and automation retraining programs.",
    keywords: ["apprenticeship", "talent pipeline", "workforce development"],
    color: "#18D69A"
  }
];

const approvedSources = [
  { name: "NIST Manufacturing News", type: "Federal Agency / Standards", url: "https://www.nist.gov" },
  { name: "Manufacturing Dive", type: "Trade Journalism", url: "https://www.manufacturingdive.com" },
  { name: "Supply Chain Dive", type: "Logistics Intelligence", url: "https://www.supplychaindive.com" },
  { name: "The Robot Report", type: "Automation & Robotics", url: "https://www.roboticsbusinessreview.com" },
  { name: "MIT Technology Review", type: "Academic & Frontier Tech", url: "https://www.technologyreview.com" }
];
---

<Layout title="SignalBrief | Topics & Sources Explorer" domain="Taxonomy">
  <div class="space-y-8">
    <div class="space-y-1.5">
      <div class="flex items-center gap-2 font-mono text-xs text-[#18D69A]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#18D69A]"></span>
        <span>AUDITED TAXONOMY & SOURCES</span>
      </div>
      <h1 class="text-2xl font-extrabold text-[#F4F5F7] tracking-tight sm:text-3xl">
        Topics & Monitored Feeds
      </h1>
      <p class="text-xs text-[#9299A8] font-mono leading-relaxed">
        Empirically audited feeds and analytical subtopic clusters monitored for SignalBrief intelligence gathering.
      </p>
    </div>

    <!-- Subtopics Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {topics.map((t) => (
        <div class="bg-[#121318] border border-[#252832] rounded-xl p-5 flex flex-col justify-between hover:border-[#384050] transition-colors">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full" style={`background-color: ${t.color}`}></span>
              <h3 class="text-sm font-bold text-white">{t.name}</h3>
            </div>
            <p class="text-xs text-[#9299A8] leading-relaxed mb-4">{t.description}</p>
          </div>
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-[#252832]">
            {t.keywords.map((kw) => (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#090A0F] text-[#9299A8] border border-[#252832]">
                {kw}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Verified Sources Section -->
    <div class="bg-[#0D0E12] border border-[#252832] rounded-xl p-6 space-y-4 shadow-sm">
      <div class="flex items-center justify-between pb-3 border-b border-[#252832]">
        <div>
          <h2 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#18D69A]"></span>
            Audited Public Feed Registry
          </h2>
          <p class="text-xs text-[#9299A8] font-mono mt-0.5">
            100% cited primary endpoints. Zero algorithmic fabrication.
          </p>
        </div>
        <span class="text-[10px] font-mono px-2.5 py-1 rounded bg-[#18D69A]/10 text-[#18D69A] border border-[#18D69A]/30 font-semibold">
          5 Verified Feeds
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        {approvedSources.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3.5 rounded-lg bg-[#121318] border border-[#252832] hover:border-[#32B8F4]/50 transition-colors flex items-center justify-between group"
          >
            <div>
              <span class="font-semibold text-xs text-[#F4F5F7] block group-hover:text-white">{s.name}</span>
              <span class="text-[10px] font-mono text-[#626B7B]">{s.type}</span>
            </div>
            <span class="text-[#32B8F4] text-xs">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
